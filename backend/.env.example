# Copy to .env for local dev.

# Postgres connection string. Matches the docker-compose service below.
DATABASE_URL="postgresql://skillswap:skillswap@localhost:5432/skillswap?schema=public"

# API server
PORT=4000
NODE_ENV=development

# CORS allowlist (comma-separated). Add the deployed frontend origin later.
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,http://localhost:8891"

# File uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=50

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Trending job cadence (cron). Every 5 minutes by default.
TRENDING_CRON="*/5 * * * *"

# Platform fee percent (charged on top of the tier price, held with the escrow).
PLATFORM_FEE_PERCENT=5

# Rush delivery flat surcharge in paise (₹5,000 default = 500000 paise).
RUSH_SURCHARGE_PAISE=500000
